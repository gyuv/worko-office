  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node", "outDir": "dist", "rootDir": "src",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true, "skipLibCheck": true, "sourceMap": true
  },
  "include": ["src"], "exclude": ["src/**/*.test.ts"]
}
