{
  "name": "worko",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@worko/api --filter=@worko/web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "desktop:dev": "pnpm --filter @worko/desktop dev",
    "mobile:dev": "pnpm --filter @worko/mobile dev",
    "seed:demo": "pnpm --filter @worko/api seed:demo"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@types/node": "^22.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@swc/core"
    ]
  }
}
