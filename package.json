{
  "name": "worko",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@worko/api --filter=@worko/web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "desktop:dev": "pnpm --filter @worko/desktop dev",
    "mobile:dev": "pnpm --filter @worko/mobile dev",
    "seed:demo": "pnpm --filter @worko/api seed:demo",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@swc/core"
    ]
  },
  "type": "module"
}
