# --- Core ---
PORT=3000
# Proxy hops in front of the API whose X-Forwarded-For is trusted (0 = none; 1 behind a single load balancer). Attendance IP checks use it.
TRUST_PROXY=0
DATABASE_URL=postgres://worko:worko@localhost:5432/worko
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=worko
S3_ACCESS_KEY=worko
S3_SECRET_KEY=worko-secret
JWT_SIGNING_KEY=change-me
KMS_MASTER_KEY_ID=local-dev
# --- Providers (leave blank to use mocks; see docs/INTEGRATIONS.md) ---
GSTIN_LOOKUP_PROVIDER=mock
GST_STATUS_PROVIDER=mock
# Phase 7 channels (D98): mock (default) | smtp (email, Mailpit locally) | meta (WhatsApp Cloud API) | http (SMS gateway, DLT).
COMM_EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@worko.local
COMM_WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
COMM_SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
DLT_ENTITY_ID=
# Mock inbound webhook (/v1/comm/webhooks/mock/<tenant>) exists only outside production with mock WhatsApp+SMS; header x-worko-signature.
COMM_WEBHOOK_SECRET=
# Gmail / Outlook OAuth (mail + calendar connect). Tokens are stored encrypted (KeyService).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Public booking pages / ICS feeds: requests per minute per IP.
BOOKING_RATE_LIMIT=20
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# mock | razorpay. Production refuses to boot with mock, or with an empty/default RAZORPAY_WEBHOOK_SECRET (D81).
# The mock webhook route (/v1/billing/webhooks/mock/...) exists only when PAYMENT_PROVIDER=mock and NODE_ENV != production;
# its signature (header x-worko-signature) uses PAYMENT_WEBHOOK_SECRET, or a dev default when empty.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
# Base URL used in signed invoice links sent to clients
PUBLIC_API_URL=http://localhost:3000/v1
FCM_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
ESIGN_PROVIDER=mock
# --- Security ---
FIELD_ENCRYPTION_KEY=change-me-32+chars
ALLOW_SIGNUP=true
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT=300
AUTH_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=5
# --- Tests: admin connection used to create throwaway databases ---
TEST_DATABASE_URL=postgres://worko:worko@localhost:5432/postgres
# --- Notifications ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.in
JOB_POLL_MS=2000
